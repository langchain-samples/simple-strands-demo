# Copy this file to .env and fill in your values

# LangSmith
LANGSMITH_API_KEY=<langsmith_api_key>
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=simple-strands-demo
LANGSMITH_WORKSPACE_ID=<workspace_id>
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# OpenTelemetry (LangSmith OTEL endpoint)
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.smith.langchain.com/otel/v1/traces
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://api.smith.langchain.com/otel/v1/traces
OTEL_EXPORTER_OTLP_HEADERS="x-api-key=<langsmith_api_key>,Langsmith-Project=simple-strands-demo"
